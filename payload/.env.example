# Server-only. Never copy these values into dist/ or a NEXT_PUBLIC variable.
PAYLOAD_SECRET=
APP_ORIGIN=http://localhost:3000
# Local development uses a SQLite file. Production needs a durable database.
# Keep Make's generated adapter/database connection when integrating there.
DATABASE_URI=file:./figsaw.db
DATABASE_AUTH_TOKEN=
OWNER_EMAIL=
# Used once by npm run bootstrap-owner. Remove after the account is created.
OWNER_INITIAL_PASSWORD=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register APP_ORIGIN/api/figsaw/linkedin/callback in LinkedIn.
LINKEDIN_API_VERSION=202610
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Figsaw
# Typed aliases fail closed without a semantic reviewer; LinkedIn requires consent.
NAME_REVIEW_URL=
NAME_REVIEW_TOKEN=
# Set ONLY when the host overwrites this header with the real client IP.
# Rate limits store a daily HMAC, never the raw address.
TRUSTED_IP_HEADER=
PROMO_VIDEO_URL=https://figsaw.figma.site/assets/figsaw-promo.mp4
